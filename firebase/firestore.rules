rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /pokemonGTournamentRankings/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid)
        && validEntry()
        && request.resource.data.score >= resource.data.score
        && (request.resource.data.score > resource.data.score
          || request.resource.data.stage >= resource.data.stage);
      allow delete: if false;

      function isOwner(uid) {
        return request.auth != null && request.auth.uid == uid
          && request.resource.data.userId == uid;
      }

      function validEntry() {
        return request.resource.data.keys().hasOnly([
            'userId', 'nickname', 'pokemon', 'stage', 'score', 'savedAt'
          ])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2
          && request.resource.data.nickname.size() <= 16
          && request.resource.data.pokemon is string
          && request.resource.data.pokemon.size() >= 1
          && request.resource.data.pokemon.size() <= 24
          && request.resource.data.stage is int
          && request.resource.data.stage >= 1
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.savedAt is timestamp;
      }
    }

    match /pokemonGTournamentBattleLogs/{logId} {
      allow create: if request.auth != null && validBattleLog();
      allow read, update, delete: if false;

      function validBattleLog() {
        return request.resource.data.keys().hasOnly([
            'battleId', 'sessionId', 'gameVersion', 'startedAt', 'finishedAt',
            'stage', 'mapTheme', 'playerPokemon', 'enemyPokemon', 'actions',
            'result', 'rounds', 'score', 'playerHp', 'playerEnergy', 'enemyHp',
            'enemyEnergy', 'userId', 'savedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.battleId is string
          && request.resource.data.battleId.size() >= 8
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() >= 8
          && request.resource.data.gameVersion is string
          && request.resource.data.startedAt is int
          && request.resource.data.finishedAt is int
          && request.resource.data.finishedAt >= request.resource.data.startedAt
          && request.resource.data.stage is int
          && request.resource.data.stage >= 1
          && request.resource.data.mapTheme is string
          && request.resource.data.playerPokemon is string
          && request.resource.data.enemyPokemon is string
          && request.resource.data.actions is list
          && request.resource.data.actions.size() <= 120
          && request.resource.data.result in ['승리', '패배']
          && request.resource.data.rounds is int
          && request.resource.data.rounds >= 1
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.playerHp is int
          && request.resource.data.playerEnergy is int
          && request.resource.data.enemyHp is int
          && request.resource.data.enemyEnergy is int
          && request.resource.data.savedAt is timestamp;
      }
    }

    match /pokemonGTournamentRooms/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && validRoomCode(roomCode)
        && validRoom();
      allow update: if request.auth != null
        && validRoomCode(roomCode)
        && validRoom()
        && isParticipant()
        && immutableRoomIdentity()
        && allowedRoomChange();
      allow delete: if false;

      function validRoomCode(roomCode) {
        return roomCode is string && roomCode.size() == 5;
      }

      function isHost() {
        return resource.data.hostId == request.auth.uid;
      }

      function isGuest() {
        return resource.data.guestId == request.auth.uid;
      }

      function isJoiningGuest() {
        return resource.data.guestId == null
          && request.resource.data.guestId == request.auth.uid
          && resource.data.status == 'waiting';
      }

      function isParticipant() {
        return isHost() || isGuest() || isJoiningGuest();
      }

      function immutableRoomIdentity() {
        return request.resource.data.hostId == resource.data.hostId
          && (resource.data.guestId == null || request.resource.data.guestId == resource.data.guestId)
          && (resource.data.hostPokemonId == null || request.resource.data.hostPokemonId == resource.data.hostPokemonId)
          && (resource.data.guestPokemonId == null || request.resource.data.guestPokemonId == resource.data.guestPokemonId)
          && (resource.data.selectionSeconds == null || request.resource.data.selectionSeconds == resource.data.selectionSeconds)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function allowedRoomChange() {
        return isHost()
          || (isGuest()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'guestPokemonId', 'guestQueue', 'guestConnectedAt', 'updatedAt'
            ]))
          || (isJoiningGuest()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'guestId', 'guestPokemonId', 'guestQueue', 'guestConnectedAt', 'status', 'updatedAt'
            ]));
      }

      function validRoom() {
        return request.resource.data.keys().hasOnly([
            'hostId', 'guestId', 'hostPokemonId', 'guestPokemonId', 'hostQueue',
            'guestQueue', 'status', 'round', 'turn', 'lastFirst', 'mapTheme', 'selectionSeconds', 'selectionDeadline',
            'battleState', 'hostConnectedAt', 'guestConnectedAt', 'disconnectAt',
            'disconnectedSide', 'winnerSide', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.hostId is string
          && (request.resource.data.guestId == null || request.resource.data.guestId is string)
          && (request.resource.data.hostPokemonId == null || request.resource.data.hostPokemonId is string)
          && (request.resource.data.guestPokemonId == null || request.resource.data.guestPokemonId is string)
          && request.resource.data.hostQueue is list
          && request.resource.data.hostQueue.size() <= 3
          && request.resource.data.guestQueue is list
          && request.resource.data.guestQueue.size() <= 3
          && request.resource.data.status in ['waiting', 'partner-select', 'selecting', 'resolving', 'finished']
          && request.resource.data.round is int
          && request.resource.data.round >= 1
          && request.resource.data.turn is int
          && request.resource.data.turn >= 0
          && request.resource.data.lastFirst in ['host', 'guest']
          && request.resource.data.mapTheme is string
          && (request.resource.data.selectionSeconds == null
            || (request.resource.data.selectionSeconds is int
              && request.resource.data.selectionSeconds >= 20
              && request.resource.data.selectionSeconds <= 60))
          && (request.resource.data.selectionDeadline == null || request.resource.data.selectionDeadline is int)
          && request.resource.data.battleState is map
          && request.resource.data.hostConnectedAt is int
          && (request.resource.data.guestConnectedAt == null || request.resource.data.guestConnectedAt is int)
          && (request.resource.data.disconnectAt == null || request.resource.data.disconnectAt is int)
          && (request.resource.data.disconnectedSide == null || request.resource.data.disconnectedSide in ['host', 'guest'])
          && (request.resource.data.winnerSide == null || request.resource.data.winnerSide in ['host', 'guest'])
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int;
      }
    }
  }
}
