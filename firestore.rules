rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /pokemonGTournamentRankings/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid)
        && validEntry()
        && request.resource.data.score >= resource.data.score
        && (request.resource.data.score > resource.data.score
          || request.resource.data.stage >= resource.data.stage);
      allow delete: if false;

      function isOwner(uid) {
        return request.auth != null && request.auth.uid == uid
          && request.resource.data.userId == uid;
      }

      function validEntry() {
        return request.resource.data.keys().hasOnly([
            'userId', 'nickname', 'pokemon', 'stage', 'score', 'savedAt'
          ])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 2
          && request.resource.data.nickname.size() <= 16
          && request.resource.data.pokemon is string
          && request.resource.data.pokemon.size() >= 1
          && request.resource.data.pokemon.size() <= 24
          && request.resource.data.stage is int
          && request.resource.data.stage >= 1
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.savedAt is timestamp;
      }
    }
  }
}
